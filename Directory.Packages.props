<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cratis -->
    <PackageVersion Include="Cratis.Fundamentals" Version="7.33.1" />
    <PackageVersion Include="Cratis" Version="22.177.0" />
    <PackageVersion Include="Cratis.Arc.Core" Version="22.177.0" />
    <PackageVersion Include="Cratis.Arc.MongoDB" Version="22.177.0" />
    <PackageVersion Include="Cratis.Arc.ProxyGenerator.Build" Version="22.177.0" />
    <PackageVersion Include="Cratis.AI" Version="7.142.1" />
    <PackageVersion Include="Cratis.Chronicle" Version="19.147.2" />
    <PackageVersion Include="Cratis.Chronicle.Contracts" Version="19.147.2" />
    <PackageVersion Include="Cratis.Chronicle.CodeAnalysis" Version="19.147.2" />
    <PackageVersion Include="Cratis.Screenplay" Version="6.7.0" />
    <!-- AI -->
    <PackageVersion Include="Anthropic" Version="13.6.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <!-- Microsoft -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    <!-- Orleans — the interpreter's service mode hosts sessions as grains -->
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Serialization.SystemTextJson" Version="10.4.2" />
    <!-- Capture sources -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Storage -->
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <!-- Samples — Library sample (Aspire 13.2, EF Core 10, OpenTelemetry) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.2" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.MongoDB" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.4" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <!--
        Aspire 13.2.4 pulls these in transitively at versions with published advisories (MessagePack and
        SharpCompress via StreamJsonRpc and the MongoDB health check, Snappier via MongoDB.Driver). Lifting them to
        patched versions here rather than muting the audit — nothing in the AppHost depends on their old APIs.
    -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <PackageVersion Include="SharpCompress" Version="0.50.8" />
    <!--
        System.Security.Cryptography.Pkcs comes in transitively (via the Extractor's and the Library sample's
        dependencies) at 9.0.x and 10.0.12, which carry published advisories (GHSA-846f-f764-76mx,
        GHSA-2fmv-rv2c-59x7). The Extractor and the Library sample's Core, Composition and Tests reference it
        directly to lift it to the patched version.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Analysis -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.322" />
    <!-- Testing & Specifications -->
    <PackageVersion Include="Cratis.Arc.Chronicle.Testing" Version="22.177.0" />
    <PackageVersion Include="Cratis.Chronicle.Testing" Version="19.147.2" />
    <PackageVersion Include="Cratis.Specifications" Version="5.2.3" />
    <PackageVersion Include="Cratis.Specifications.XUnit.v3" Version="5.2.3" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
</Project>