<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <!-- This app has no inline specs; opt out of the shared spec settings. -->
        <DedicatedSpecsProject>true</DedicatedSpecsProject>
        <IsTestProject>false</IsTestProject>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <OutputType>Exe</OutputType>
        <AssemblyName>Cratis.Prologue.Receiver</AssemblyName>
        <RootNamespace>Cratis.Prologue.Receiver</RootNamespace>
        <NoWarn>$(NoWarn);CS7022</NoWarn>
        <!-- Prologue models with Screenplay elsewhere; there are no .play documents for Arc to embed. -->
        <CratisEmbeddedScreenplayEnabled>false</CratisEmbeddedScreenplayEnabled>
        <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Fundamentals" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Contracts/Contracts.csproj" />
        <ProjectReference Include="../Storage/Storage.csproj" />
        <ProjectReference Include="../Workbench/Workbench.csproj" />
    </ItemGroup>
</Project>
