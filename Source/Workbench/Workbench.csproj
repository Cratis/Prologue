<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Cratis.Prologue.Workbench</AssemblyName>
        <RootNamespace>Cratis.Prologue.Workbench</RootNamespace>
        <Description>The Prologue Workbench: backend slices and their frontend, hosted by the Receiver.</Description>
        <!--
            The specs live in Workbench.Specs. This assembly is hosted by the Receiver and must not reference
            Cratis.Chronicle.Testing: that package carries the Chronicle kernel, whose [Authorize] artifacts Arc would
            then discover in the Receiver and refuse to start on policies only the Chronicle server defines.
        -->
        <DedicatedSpecsProject>true</DedicatedSpecsProject>
        <!-- A library in Release; Debug stays an executable because xUnit flows in from the spec-bearing project references. -->
        <OutputType Condition="'$(Configuration)' == 'Release'">Library</OutputType>
        <!-- Prologue models with Screenplay elsewhere; there are no .play documents for Arc to embed. -->
        <CratisEmbeddedScreenplayEnabled>false</CratisEmbeddedScreenplayEnabled>
        <!-- Receiver hosts hot reload; a browser-tools module here leaves an unmatched JS-module endpoint in the .NET 11 SDK. -->
        <EnableHotReloadInRuntimeConfigDevFile>false</EnableHotReloadInRuntimeConfigDevFile>
        <!-- Hosted by the Receiver, never shipped as a package; the release packs the whole solution. -->
        <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    </PropertyGroup>

    <!-- Arc proxies are generated next to the C# on Debug builds only; they are committed. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <CratisProxiesOutputPath>$(MSBuildThisFileDirectory)</CratisProxiesOutputPath>
        <CratisProxiesSegmentsToSkip>1</CratisProxiesSegmentsToSkip>
        <CratisProxiesSkipOutputDeletion>true</CratisProxiesSkipOutputDeletion>
        <CratisProxiesSkipCommandNameInRoute>true</CratisProxiesSkipCommandNameInRoute>
        <CratisProxiesUseSourceFileAsOutputFile>true</CratisProxiesUseSourceFileAsOutputFile>
    </PropertyGroup>

    <ItemGroup>
        <NamespaceRoot Include="Workbench" Namespace="Cratis.Prologue.Workbench" Folder="." />
        <NamespaceRoot Include="Contracts" Namespace="Cratis.Prologue.Contracts" Folder="." />
        <NamespaceRoot Include="InterpreterContracts" Namespace="Cratis.Prologue.Interpreter.Contracts" Folder="." />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cratis" />
        <PackageReference Include="Cratis.AI" />
        <PackageReference Include="Cratis.Arc.Core" />
        <PackageReference Include="Cratis.Arc.MongoDB" />
        <PackageReference Include="Cratis.Arc.ProxyGenerator.Build" />
        <PackageReference Include="Cratis.Chronicle" />
        <PackageReference Include="Cratis.Chronicle.Contracts" />
        <PackageReference Include="Cratis.Chronicle.CodeAnalysis" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
        <PackageReference Include="Cratis.Fundamentals" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Configuration/Configuration.csproj" />
        <ProjectReference Include="../Contracts/Contracts.csproj" />
        <ProjectReference Include="../Interpretation/Interpretation.csproj" />
        <ProjectReference Include="../Interpreter.Contracts/Interpreter.Contracts.csproj" />
        <ProjectReference Include="../Screenplay/Screenplay.csproj" />
        <ProjectReference Include="../Storage/Storage.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="package.json;tsconfig*.json" />
        <None Remove="package.json;tsconfig*.json" />
        <Compile Remove="node_modules/**" />
        <!-- Specs are compiled by Workbench.Specs. -->
        <Compile Remove="**/for_*/**;**/when_*/**;**/given/**" />
    </ItemGroup>
</Project>
