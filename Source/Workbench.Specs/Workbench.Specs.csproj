<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <AssemblyName>Cratis.Prologue.Workbench.Specs</AssemblyName>
        <RootNamespace>Cratis.Prologue.Workbench</RootNamespace>
        <Description>The specs of the Prologue Workbench. They run Arc and Chronicle in process, which the hosted Workbench must not reference.</Description>
        <CratisEmbeddedScreenplayEnabled>false</CratisEmbeddedScreenplayEnabled>
        <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Nothing here is shipped; Release builds an empty library. -->
        <OutputType Condition="'$(Configuration)' == 'Release'">Library</OutputType>
        <!-- The Workbench's own proxies are generated by the Workbench; this project has none to emit. -->
        <CratisProxiesOutputPath Condition="'$(Configuration)' == 'Debug'">$(MSBuildThisFileDirectory)obj/proxies/</CratisProxiesOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Prologue.Workbench.Specs" />
    </ItemGroup>

    <!-- The specs sit beside the code they specify in ../Workbench (for_*, when_* and given folders). -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <WorkbenchSpec Include="../Workbench/**/for_*/**/*.cs;../Workbench/**/when_*/**/*.cs;../Workbench/**/given/**/*.cs" Exclude="../Workbench/obj/**;../Workbench/bin/**;../Workbench/node_modules/**" />
        <Compile Include="@(WorkbenchSpec->Distinct())" LinkBase="." />
        <Compile Include="../Workbench/GlobalUsings.cs;../Workbench/GlobalUsings.Domain.cs;../Workbench/AI/AIGlobalUsings.cs" LinkBase="." />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Arc.Chronicle.Testing" />
        <PackageReference Include="Cratis.Chronicle.Testing" />
        <PackageReference Include="Cratis.Chronicle.CodeAnalysis" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Workbench/Workbench.csproj" />
    </ItemGroup>
</Project>
