<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <!-- The specs live in the sibling .Specs project; the app must not double as a test project. -->
        <DedicatedSpecsProject>true</DedicatedSpecsProject>
        <IsTestProject>false</IsTestProject>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <OutputType>Exe</OutputType>
        <AssemblyName>Cratis.Prologue.Extractor</AssemblyName>
        <RootNamespace>Cratis.Prologue.Extractor</RootNamespace>
        <NoWarn>$(NoWarn);CS7022</NoWarn>
        <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Fundamentals" />
        <PackageReference Include="Microsoft.Data.SqlClient" />
        <PackageReference Include="Npgsql" />
        <PackageReference Include="Yarp.ReverseProxy" />
        <PackageReference Include="Grpc.AspNetCore" />
        <PackageReference Include="Grpc.Net.Client" />

        <!-- Lift the vulnerable transitive to the patched version; see Directory.Packages.props. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Contracts/Contracts.csproj" />
        <ProjectReference Include="../Configuration/Configuration.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Vendored OTLP contracts; Grpc.Tools generates the messages and the TraceService server/client. -->
        <Protobuf Include="Protos/**/*.proto" ProtoRoot="Protos" GrpcServices="Both" />
    </ItemGroup>
</Project>
