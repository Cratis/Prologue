        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Cratis.Prologue.Configuration</AssemblyName>
        <RootNamespace>Cratis.Prologue.Configuration</RootNamespace>
        <IsPackable>true</IsPackable>
        <TargetFramework />
